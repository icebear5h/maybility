generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum CalendarType {
  GOOGLE
  INTERNAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum EventStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  CONFIDENTIAL
}

enum OccurrenceType {
  SINGLE // One-time event
  RECURRING // Repeating event (uses RRule)
}

// ============================================================================
// AUTH MODELS
// ============================================================================

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  timezone      String? // User's default timezone
  calendarType  CalendarType @default(INTERNAL)
  preferences   Json? // Calendar and general preferences

  // Relations
  accounts Account[]
  sessions Session[]
  events   Event[]
  goals    Goal[]
  stages   Stage[]
  settings UserSettings?

  @@map("users")
}

// ============================================================================
// USER SETTINGS MODEL
// ============================================================================

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  // Agent Settings
  fastModel        String  @default("llama-3.1-8b-instant")
  reasoningModel   String  @default("openai/gpt-oss-120b")
  routerThreshold  Float   @default(0.7)
  enableComplexPath Boolean @default(true)

  // Custom Prompts (override defaults from .txt files)
  customRouterPrompt       String? @db.Text
  customSimplePrompt       String? @db.Text
  customOrchestratorPrompt String? @db.Text
  customSynthesizerPrompt  String? @db.Text
  customSetTasksPrompt     String? @db.Text

  // General
  timezone String @default("UTC")

  // Theme/Appearance
  themePreset  String @default("dark")
  accentHue    Int    @default(200)
  accentChroma Float  @default(0.15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ============================================================================
// EVENT MODEL - Unified model for both scheduled events and unscheduled tasks
// ============================================================================

model Event {
  id          String  @id @default(cuid())
  title       String
  description String?
  location    String?
  url         String? // Video call link, etc.

  // Time fields (optional for unscheduled tasks, stored in UTC when present)
  startTime DateTime? // When scheduled
  endTime   DateTime? // When scheduled
  timezone  String? // IANA timezone (e.g., "America/New_York")
  isAllDay  Boolean  @default(false)

  // Soft deadline for unscheduled tasks
  dueDate DateTime?

  // Task fields (optional for pure calendar events)
  taskStatus  TaskStatus? // TODO, IN_PROGRESS, DONE
  priority    Priority    @default(MEDIUM)
  completedAt DateTime?

  // Event metadata
  eventStatus EventStatus     @default(CONFIRMED) // TENTATIVE, CONFIRMED, CANCELLED
  visibility  EventVisibility @default(PRIVATE)
  color       String          @default("#3b82f6")

  // Recurrence
  occurrenceType OccurrenceType @default(SINGLE)
  rrule          String? // RRule string for recurring events

  // Optional link to local journal entry
  entryPath String? // Relative path to journal entry file

  userId  String
  goalId  String?
  stageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal?                @relation(fields: [goalId], references: [id], onDelete: Cascade)
  stage      Stage?               @relation(fields: [stageId], references: [id], onDelete: Cascade)
  exceptions RecurringException[]
  overrides  RecurringOverride[]
  attendees  EventAttendee[]
  reminders  Reminder[]

  @@index([userId])
  @@index([goalId])
  @@index([stageId])
  @@index([startTime])
  @@index([dueDate])
  @@index([taskStatus])
  @@index([userId, startTime])
  @@index([userId, dueDate])
  @@map("events")
}

// ============================================================================
// EVENT RECURRENCE MODELS
// ============================================================================

model RecurringException {
  id            String   @id @default(cuid())
  eventId       String
  originalStart DateTime // UTC timestamp of the occurrence being excepted
  isCancelled   Boolean  @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStart])
  @@map("recurring_exceptions")
}

model RecurringOverride {
  id            String   @id @default(cuid())
  eventId       String
  originalStart DateTime // UTC timestamp of the occurrence being overridden

  // Overridden values (null = use original)
  newStart    DateTime?
  newEnd      DateTime?
  title       String?
  description String?
  location    String?
  eventStatus EventStatus?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStart])
  @@map("recurring_overrides")
}

// ============================================================================
// EVENT ATTENDEES & REMINDERS
// ============================================================================

model EventAttendee {
  id          String   @id @default(cuid())
  eventId     String
  email       String
  name        String?
  isOptional  Boolean  @default(false)
  hasAccepted Boolean?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("event_attendees")
}

model Reminder {
  id            String @id @default(cuid())
  eventId       String
  minutesBefore Int // e.g., 15 for 15 minutes before
  method        String @default("notification") // notification, email, etc.

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// ============================================================================
// GOAL MODEL
// ============================================================================

model Goal {
  id               String    @id @default(cuid())
  title            String
  description      String?
  targetDate       DateTime?
  definitionOfDone String?
  color            String?
  archived         Boolean   @default(false)

  // Optional links to local journal entries (array of paths)
  entryPaths Json? // Array of relative paths to related journal entries

  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages Stage[]
  events Event[]

  @@index([userId])
  @@map("goals")
}

// ============================================================================
// STAGE MODEL - Sequential breakdown of goals
// ============================================================================

model Stage {
  id          String    @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime?
  color       String?

  order Float // Fractional ordering for easy insertion: 0, 1, 1.5, 2...

  // Optional links to local journal entries (array of paths)
  entryPaths Json? // Array of relative paths to related journal entries

  userId    String
  goalId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  events Event[]

  @@index([userId])
  @@index([goalId])
  @@index([goalId, order]) // Query stages by goal in order
  @@map("stages")
}
