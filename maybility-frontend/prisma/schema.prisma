generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum CalendarType {
  GOOGLE
  INTERNAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum EventStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  CONFIDENTIAL
}

enum OccurrenceType {
  SINGLE      // One-time event
  RECURRING   // Repeating event (uses RRule)
}

enum UpdateKind {
  TASK_COMPLETION
  REFLECTION
  MILESTONE
  EVENT_NOTE
}

// ============================================================================
// AUTH MODELS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  timezone      String?   // User's default timezone
  calendarType  CalendarType @default(INTERNAL)
  preferences   Json?     // Calendar and general preferences

  // Relations
  accounts      Account[]
  sessions      Session[]
  entries       Entry[]
  folders       Folder[]
  tasks         Task[]
  events        Event[]
  goals         Goal[]
  updates       Update[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ============================================================================
// CONTENT MODELS
// ============================================================================

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  userId    String
  goalId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isRoot    Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children Folder[] @relation("FolderHierarchy")
  entries  Entry[]
  goal     Goal?    @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([parentId])
  @@index([userId, parentId])
  @@map("folders")
}

model Entry {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  folderId  String
  userId    String
  goalId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([folderId])
  @@index([userId, folderId])
  @@map("entries")
}

// ============================================================================
// TASK MODEL - For todo items with completion tracking
// ============================================================================

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  color       String     @default("#3b82f6")

  // Optional soft deadline (not a scheduled time)
  dueDate     DateTime?

  userId      String
  goalId      String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  updates Update[]

  @@index([userId])
  @@index([goalId])
  @@index([status])
  @@map("tasks")
}

// ============================================================================
// EVENT MODEL - For calendar events with time/location/attendees
// ============================================================================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  url         String?  // Video call link, etc.

  // Time fields (stored in UTC)
  startTime   DateTime
  endTime     DateTime
  timezone    String   // IANA timezone (e.g., "America/New_York")
  isAllDay    Boolean  @default(false)

  // Event metadata
  status      EventStatus     @default(CONFIRMED)
  visibility  EventVisibility @default(PRIVATE)
  color       String?

  // Recurrence
  occurrenceType OccurrenceType @default(SINGLE)
  rrule          String?        // RRule string for recurring events

  userId      String
  goalId      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?                 @relation(fields: [goalId], references: [id], onDelete: Cascade)
  exceptions  RecurringException[]
  overrides   RecurringOverride[]
  attendees   EventAttendee[]
  reminders   Reminder[]
  updates     Update[]

  @@index([userId])
  @@index([goalId])
  @@index([startTime])
  @@index([userId, startTime])
  @@map("events")
}

// ============================================================================
// EVENT RECURRENCE MODELS
// ============================================================================

model RecurringException {
  id            String   @id @default(cuid())
  eventId       String
  originalStart DateTime // UTC timestamp of the occurrence being excepted
  isCancelled   Boolean  @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStart])
  @@map("recurring_exceptions")
}

model RecurringOverride {
  id            String      @id @default(cuid())
  eventId       String
  originalStart DateTime    // UTC timestamp of the occurrence being overridden

  // Overridden values (null = use original)
  newStart      DateTime?
  newEnd        DateTime?
  title         String?
  description   String?
  location      String?
  status        EventStatus?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStart])
  @@map("recurring_overrides")
}

// ============================================================================
// EVENT ATTENDEES & REMINDERS
// ============================================================================

model EventAttendee {
  id         String  @id @default(cuid())
  eventId    String
  email      String
  name       String?
  isOptional Boolean @default(false)
  hasAccepted Boolean?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("event_attendees")
}

model Reminder {
  id            String   @id @default(cuid())
  eventId       String
  minutesBefore Int      // e.g., 15 for 15 minutes before
  method        String   @default("notification") // notification, email, etc.

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// ============================================================================
// GOAL MODEL
// ============================================================================

model Goal {
  id               String    @id @default(cuid())
  title            String
  description      String?
  targetDate       DateTime?
  definitionOfDone String?
  color            String?
  archived         Boolean   @default(false)
  userId           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks   Task[]
  events  Event[]
  entries Entry[]
  folders Folder[]
  updates Update[]

  @@index([userId])
  @@map("goals")
}

// ============================================================================
// UPDATE MODEL - Notes/reflections on tasks, events, goals
// ============================================================================

model Update {
  id        String     @id @default(cuid())
  taskId    String?
  eventId   String?
  goalId    String?
  kind      UpdateKind
  body      String     @db.Text
  userId    String
  createdAt DateTime   @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  goal  Goal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskId])
  @@index([eventId])
  @@index([goalId])
  @@map("updates")
}
