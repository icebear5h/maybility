# --- deps ---
**/node_modules/
# catch accidental typo folder
**/node_module/

# --- Next.js outputs ---
**/.next/
**/out/

# --- builds / bundles ---
**/build/
**/dist/
**/.turbo/
**/.cache/
**/.parcel-cache/

# --- logs ---
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/pnpm-debug.log*

# --- env files ---
**/.env
**/.env.*
!**/.env.example          # keep example envs in repo

# --- Vercel / deployment ---
**/.vercel/

# --- TypeScript ---
**/*.tsbuildinfo
**/next-env.d.ts

# --- OS/Editor junk ---
.DS_Store
Thumbs.db
**/.idea/
# If you want to keep recommended VS Code settings, remove the next line
**/.vscode/
git 